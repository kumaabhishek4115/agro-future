# PostgreSQL connection (default: localhost dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agro_future

# JWT – CHANGE THIS in production!
JWT_SECRET=agro-future-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Sensitive supplier payout data – CHANGE THIS in production!
PAYOUT_DETAILS_SECRET=agro-future-dev-payout-secret-change-in-prod
