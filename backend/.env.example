# PostgreSQL connection (default: localhost dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agro_future

# JWT – CHANGE THIS in production!
JWT_SECRET=agro-future-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Twilio Emails API – leave blank to disable outbound email locally.
# Use an API Key SID/Secret pair; never commit real values.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Agro Future
FRONTEND_BASE_URL=http://localhost:3000

# Twilio SMS – leave blank to disable outbound SMS locally.
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM=
MOBILE_CODE_TTL_MINUTES=10
